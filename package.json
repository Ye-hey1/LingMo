    "dev:rebuild": "node scripts/start-lingmo-dev.mjs --rebuild-tauri",
    "dev:turbo": "next dev --turbopack -p 3457 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3457",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:agent": "node scripts/agent-core-tests.mjs",
